# AWS Infrastructure (ap-south-1 Mumbai)
# Strict Resource Isolation: Credentials must be scoped strictly to parnika-jewellers-v0-* and parnika_*
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
DYNAMO_TABLE_PREFIX=parnika_
S3_BUCKET_NAME=parnika-jewellers-v0-prod
CLOUDFRONT_DISTRIBUTION_DOMAIN=assets.parnikajewellers.com

# Optional local DynamoDB endpoint for testing
# DYNAMODB_ENDPOINT=http://localhost:8000

# Authentication & Admin
JWT_SECRET=replace_with_a_secure_64_character_random_string
ADMIN_BOOTSTRAP_EMAIL=admin@parnikajewellers.com
ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_secure_password

# Payment Gateway Configuration
PAYMENT_PROVIDER=youpi
YOUPI_BASE_API_URL=https://pg.parnikajewellers.com
YOUPI_API_KEY=your_youpi_api_key
YOUPI_WEBHOOK_SECRET=your_youpi_webhook_secret

# Fallback Gateway (Razorpay - Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# External Services
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_STORE_NUMBER=+919876543210
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NEXT_PUBLIC_STORE_URL=https://www.parnikajewellers.com
